# Copy to .env and adjust. Nested settings use "__" as delimiter (pydantic-settings).

# Default LLM endpoint used by every agent unless overridden below.
# Point this at your vLLM OpenAI-compatible server, e.g.:
#   vllm serve Qwen/Qwen2.5-Coder-32B-Instruct --port 8000
MULTIGRAPHRAG_LLM__BASE_URL=http://localhost:8000/v1
# Optional: only needed if your endpoint requires auth. Unset (the default)
# sends no Authorization header at all -- most local vLLM deployments don't
# check it anyway.
# MULTIGRAPHRAG_LLM__API_KEY=sk-...
MULTIGRAPHRAG_LLM__MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
MULTIGRAPHRAG_LLM__TEMPERATURE=0.0
MULTIGRAPHRAG_LLM__MAX_CONCURRENCY=5

# Max completion tokens per call. Defaults to 16000: reasoning models can spend
# a large, variable share of this on chain-of-thought before ever writing the
# final `content`, so a low/unset cap risks silently truncating the structured
# JSON output every agent depends on. Set to empty/None to let the endpoint
# apply its own default instead.
# MULTIGRAPHRAG_LLM__MAX_TOKENS=16000

# Whether the model is allowed to use its default chain-of-thought/"thinking"
# behavior. Defaults to true. Set to false to actively suppress it via
# chat_template_kwargs.enable_thinking=false (the mechanism for Qwen3-style
# "thinking" models on vLLM) -- cuts completion tokens drastically (observed:
# ~101 -> ~2 for a trivial prompt) since agents only ever read the final
# `content`, never `reasoning_content`.
# MULTIGRAPHRAG_LLM__REASONING_ENABLED=false

# When reasoning is enabled, forwarded verbatim as a top-level
# `reasoning_effort` field (the OpenAI/gpt-oss-style knob: "low"/"medium"/
# "high"). Defaults to "medium". Ignored (harmlessly, confirmed empirically)
# by endpoints/models that don't recognize it, e.g. Qwen3. Set to empty/None
# to omit it entirely.
# MULTIGRAPHRAG_LLM__REASONING_EFFORT=medium

# How structured agent outputs are enforced: "json_schema" (default) relies on
# the endpoint's guided-decoding backend (response_format=json_schema, e.g.
# vLLM + outlines/xgrammar). If your vLLM build/model doesn't support that,
# switch to "prompt": the schema is embedded in the prompt text instead and
# validated client-side only (no server-side guarantee).
# MULTIGRAPHRAG_LLM__STRUCTURED_OUTPUT_MODE=prompt

# Extra fields merged verbatim into every chat-completion request, applied
# last so they can override reasoning_enabled/reasoning_effort/anything else
# above. An escape hatch for vendor-specific parameters that don't warrant a
# dedicated setting:
# MULTIGRAPHRAG_LLM__EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Optional per-agent overrides -- uncomment and fill in to route a specific
# agent to a different endpoint/model/api key than the default above.
# MULTIGRAPHRAG_AGENT_MODELS__QUERY_GENERATOR__BASE_URL=http://localhost:8001/v1
# MULTIGRAPHRAG_AGENT_MODELS__QUERY_GENERATOR__MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# MULTIGRAPHRAG_AGENT_MODELS__QUERY_GENERATOR__API_KEY=EMPTY
# MULTIGRAPHRAG_AGENT_MODELS__VERIFICATION_RANKER__BASE_URL=https://api.openai.com/v1
# MULTIGRAPHRAG_AGENT_MODELS__VERIFICATION_RANKER__MODEL=gpt-4o-mini
# MULTIGRAPHRAG_AGENT_MODELS__VERIFICATION_RANKER__API_KEY=sk-...

# Memgraph (Bolt protocol).
MULTIGRAPHRAG_MEMGRAPH__URI=bolt://localhost:7687
MULTIGRAPHRAG_MEMGRAPH__USERNAME=
MULTIGRAPHRAG_MEMGRAPH__PASSWORD=

# Self-correction loop.
MULTIGRAPHRAG_WORKFLOW__MAX_REFINEMENT_ITERATIONS=5

# CypherBench evaluation harness: how many questions per domain/mode run
# concurrently (independent questions against the same already-loaded graph).
# Raising this speeds up `multigraphrag cypherbench evaluate` substantially;
# also mind each LLMSettings.max_concurrency, which still caps in-flight
# requests to a given endpoint.
MULTIGRAPHRAG_EVALUATION__CONCURRENCY=5

# Optional LLM-as-a-judge for scoring evaluation answers (closer to the
# paper's own methodology, which uses a dedicated judge model distinct from
# the ones under test). Unset by default: scoring falls back to the
# deterministic value-overlap heuristic. Enable per-run with
# `multigraphrag cypherbench evaluate --use-judge`.
# MULTIGRAPHRAG_EVALUATION__JUDGE__BASE_URL=https://gateway-dev.llm.crystal.ai
# MULTIGRAPHRAG_EVALUATION__JUDGE__MODEL=openai/gpt-oss-120b
# MULTIGRAPHRAG_EVALUATION__JUDGE__API_KEY=EMPTY
